{
  "name": "dulluni-souq",
  "productName": "Dulluni Souq",
  "version": "1.0.0",
  "description": "دلوني على السوق — كتاب تفاعلي يعمل دون اتصال",
  "author": "Feras",
  "main": "main.js",
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.ferasglitch.dulluni",
    "productName": "Dulluni Souq",
    "files": ["main.js", "app/**"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "دلوني على السوق",
      "artifactName": "dulluni-souq-setup-${version}.exe"
    }
  }
}
